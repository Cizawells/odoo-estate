<odoo>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <filter string="Date Avail" name="filter_availability_date" date="date_availability" />
            </search>
        </field>
    </record>
    <record id="view_estate_property_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Test">
                <field name="name" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="bedrooms" />

            </tree>
        </field>
    </record>

    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_status_sold" string="Sold" type="object" />
                    <button name="action_status_cancel" string="Cancel" type="object" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                        <field name="tags_ids" widget="many2many_tags" />
                    </div>

                    <group>
                        <group>
                            <field name="status" />
                            <field name="property_type_id" />
                            <field
                                name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="best_price" />

                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="garage" />
                                <field name="living_area" title="Nomm" />
                                <field name="facades" />
                                <field name="garden" />
                                <field name="garden_area" />
                                <field name="garden_orientation" />
                                <field name="total_area" />


                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids">
                                <tree string="Offers" editable="bottom" create="true" delete="true">
                                    <field name="price" />
                                    <field name="status" />
                                    <button name="action_confirm" string="Confirm" type="object"
                                        icon="fa-check" />
                                    <button name="action_cancel" string="Cancel" type="object"
                                        icon="fa-cancel" />
                                    <field name="partner_id" />
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                </tree>
                            </field>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>


                    </notebook>
                </sheet>

            </form>
        </field>
    </record>


    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="" />
    </record>


</odoo>